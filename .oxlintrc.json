{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"no-console": ["error", { "allow": ["info", "error"] }]
	},
	"env": {
		"builtin": true
	},
	"overrides": [
		{
			"files": ["apps/site/src/pages/index.astro"],
			"rules": {
				"no-unused-expressions": "off"
			}
		}
	]
}
