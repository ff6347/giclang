{
	"name": "@giclang/content",
	"version": "0.9.0-beta.5",
	"private": true,
	"type": "module",
	"exports": {
		"./model": {
			"types": "./dist/content-model.d.ts",
			"default": "./dist/content-model.js"
		},
		"./markdown": {
			"types": "./dist/markdown-content.d.ts",
			"default": "./dist/markdown-content.js"
		},
		"./sketch-description": {
			"types": "./dist/sketch-description.d.ts",
			"default": "./dist/sketch-description.js"
		},
		"./user-markdown": {
			"types": "./dist/user-markdown.d.ts",
			"default": "./dist/user-markdown.js"
		},
		"./node": {
			"types": "./dist/content-files.d.ts",
			"default": "./dist/content-files.js"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"fflate": "0.8.3",
		"gray-matter": "4.0.3",
		"js-yaml": "4.3.2",
		"markdown-it": "15.0.2"
	},
	"devDependencies": {
		"@types/js-yaml": "4.0.9"
	}
}
