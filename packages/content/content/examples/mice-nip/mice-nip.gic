// ABOUTME: Cuts irregular circular bites from all four edges of a dark square.
// ABOUTME: Demonstrates seeded chance through repeated edge marks and slight positional variation.
// Inspired by Julia Hilt's mice-nip:
// https://github.com/ff6347/gestalten-in-code/tree/e8b8f8446c13c01494ccfd1e92ce2bb1638daf66/chance/p5js/mice-nip

randomSeed(430);
background("#fafafa");
noStroke();
fill("#262626");
rect(25, 25, 50, 50);

fill("#fafafa");
repeat(i, 0, 11) {
	circle(random(24, 26), 25 + i * 5 + random(-1.5, 1.5), 2.5);
}
repeat(i, 0, 11) {
	circle(25 + i * 5 + random(-1.5, 1.5), random(24, 26), 2.5);
}
repeat(i, 0, 11) {
	circle(random(74, 76), 25 + i * 5 + random(-1.5, 1.5), 2.5);
}
repeat(i, 0, 11) {
	circle(25 + i * 5 + random(-1.5, 1.5), random(74, 76), 2.5);
}
