{
	"name": "@giclang/runtime",
	"version": "0.9.0",
	"private": true,
	"type": "module",
	"description": "Shared browser execution and Canvas previews for GIC",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		},
		"./standalone": "./dist/runtime.iife.js"
	},
	"sideEffects": false,
	"scripts": {
		"build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
		"typecheck": "tsc --noEmit",
		"test": "node --test tests/*.test.ts"
	},
	"dependencies": {
		"@giclang/core": "workspace:^"
	},
	"devDependencies": {
		"vite": "8.2.2"
	}
}
