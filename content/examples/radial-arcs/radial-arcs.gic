// ABOUTME: Arranges four heavy arc segments around one circle.
// ABOUTME: Uses even angular gaps to imply a complete ring through closure.
// Adapted from Arcs by Fabian Morón Zirfas: https://github.com/ff6347/gestalten-in-code/tree/e8b8f8446c13c01494ccfd1e92ce2bb1638daf66/form/2d/processing/arcs

background("#ffffff");
noFill();
stroke("#000000");
strokeWidth(2);

repeat(angle, 90, 450, 90) {
	arc(50, 50, 16.67, angle - 50, angle + 20);
}
