// ABOUTME: Draws nearby random points as connected visual groups.
// ABOUTME: Demonstrates distance calculation, conditionals, and repeated drawing.
// based on https://gestalten-in-code.qawsed.site/chance/connect/
// by Fabian Morón Zirfas
// Tags: Basil.js, chance, repeat, Law of Proximity, Law of Connected Elements

func dist(x1, y1, x2, y2){
	return sqrt(pow(x2 - x1, 2) + pow(y2 - y1, 2));
}

let num = 100;
let diam = 5;
let maxDistance = diam * 3;
let x = random(0, 100);
let y = random(0, 100);
background(0, 0, 0);
fill(100, 0, 0);
stroke(60, 0, 0);
strokeWidth(1);
repeat(i, 0, num){
	let px = x;
	let py = y;
	x = random(0, 100);
	y = random(0, 100);

	if(dist(px, py, x, y) < maxDistance){
		line(px, py, x, y);
		circle(x, y, diam / 2);
		circle(px, py, diam / 2);
	} else {
		circle(px, py, diam);

	}
}
