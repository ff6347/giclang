// ABOUTME: Demonstrates a deterministic rectangle grid using nested repeats.
// ABOUTME: Exercises ordered drawing styles and intentionally clipped canvas edges.

background(70,0,0);
fill("darkgreen");
stroke("lime");
strokeWidth(1);

let step = 5;
repeat(x, 0,100,step){
repeat(y,0,100,step){
rect(x,y,step/3,step/3);
}
}
