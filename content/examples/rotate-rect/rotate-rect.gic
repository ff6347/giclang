// ABOUTME: Places a large white quadrilateral at the source rectangle's fixed 13-degree rotation.
// ABOUTME: Demonstrates figure and ground through one tilted rectangle crossing a dark Canvas.
// Adapted from Fabian Morón Zirfas's Rotate Rect:
// https://github.com/ff6347/gestalten-in-code/tree/e8b8f8446c13c01494ccfd1e92ce2bb1638daf66/form/2d/processing/rotate_rect

background("#000000");
noStroke();
fill("#ffffff");
quad(-19.95, -17.46, 77.49, 5.03, 54.99, 102.47, -42.45, 79.97);
