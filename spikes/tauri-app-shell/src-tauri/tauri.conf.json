{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "GIC Tauri Spike",
	"version": "0.1.0",
	"identifier": "dev.gic.tauri-spike",
	"build": {
		"frontendDist": "../web"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "GIC Tauri Shell Spike",
				"width": 900,
				"height": 700
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"]
	}
}
