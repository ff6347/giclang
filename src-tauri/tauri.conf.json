{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "GIC — Gestalten in Code",
	"version": "0.1.0",
	"identifier": "cc.incode.gestalten",
	"build": {
		"beforeBuildCommand": "pnpm build:browser",
		"beforeDevCommand": "pnpm dev:browser --host 127.0.0.1",
		"devUrl": "http://127.0.0.1:5173",
		"frontendDist": "../browser/dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "GIC — Gestalten in Code",
				"width": 1280,
				"height": 800,
				"minWidth": 720,
				"minHeight": 480
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob: data:; worker-src 'self' blob:"
		}
	},
	"bundle": {
		"active": true,
		"category": "Education",
		"icon": ["../browser/public/icons/gic-icon-512.png"],
		"shortDescription": "Create static generative graphics with GIC.",
		"targets": "all"
	}
}
