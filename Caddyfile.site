# ABOUTME: Serves the statically generated GIC website.
# ABOUTME: Preserves Astro's file-based routes and ordinary 404 responses.
:80 {
	root * /srv
	encode zstd gzip
	@plaintext path /llms.txt /llms-full.txt
	header @plaintext Content-Type "text/plain; charset=utf-8"
	@markdown path_regexp \.md$
	header @markdown Content-Type "text/markdown; charset=utf-8"
	file_server
}
