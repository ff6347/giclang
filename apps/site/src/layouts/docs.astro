---
import DefaultLayout from "./default.astro";
import { getCollection } from "astro:content";
import CopyButton from "../components/copy-button.astro";
import { documentationFullText } from "../lib/documentation-exports.ts";

const docs = await getCollection("docs");
const fullText = await documentationFullText();
---

<DefaultLayout>
	<div class="docs-layout">
		<aside>
			<nav aria-label="Documentation">
				<ul>
					{docs.map((doc) => (
						<li>
							<a
								href={`${import.meta.env.BASE_URL}docs/${doc.id}`}

								aria-current={
									Astro.url.pathname.replace(/\/$/, "") ===
									`${import.meta.env.BASE_URL}docs/${doc.id}`
										? "page"
										: undefined
								}
							>
								{doc.data.title}
							</a>
						</li>
					))}
				</ul>
			</nav>
			<section class="documentation-exports" aria-label="Documentation exports">
				<a href={`${import.meta.env.BASE_URL}llms.txt`}>
					Documentation index (llms.txt)
				</a>
				<div>
					<CopyButton label="Copy all docs" text={fullText} />
				</div>
				<a
					href={`${import.meta.env.BASE_URL}llms-full.txt`}
					download="llms-full.txt"
				>
					Download all docs
				</a>
				<p>
					The full document may exceed a chat's input limits. Use Copy page for
					an individual page or Download all docs instead.
				</p>
			</section>
		</aside>

		<div class="docs-content">
			<slot />
		</div>
	</div>
</DefaultLayout>

<style>
	.docs-layout {
		display: flex;
		align-items: flex-start;
		gap: 2rem;
	}

	aside {
		flex: 0 0 14rem;
	}

	.documentation-exports {
		display: flex;
		flex-direction: column;
		gap: var(--s4);
		margin-top: var(--s4);
	}

	.docs-content {
		flex: 1;
		min-width: 0;
	}

	.docs-content :global(.content-table-scroll) {
		max-width: 100%;
		overflow-x: auto;
	}

	nav a[aria-current="page"] {
		font-weight: bold;
	}

	@media (max-width: 48rem) {
		.docs-layout {
			flex-direction: column;
		}

		aside {
			flex: none;
			width: 100%;
		}

		.docs-content {
			width: 100%;
		}
	}
</style>
