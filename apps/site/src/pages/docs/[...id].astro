---
import { getCollection } from "astro:content";
import { createDocumentationCopyText } from "@giclang/content/model";
import CopyButton from "../../components/copy-button.astro";

import DocsLayout from "../../layouts/docs.astro";

export async function getStaticPaths() {
	const docs = await getCollection("docs");

	return docs.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
---

<DocsLayout>
	<main>
		<h1>{entry.data.title}</h1>
		<CopyButton
			label="Copy page"
			text={createDocumentationCopyText(entry.data)}
		/>
		{entry.id === "skill" && (
			<section class="skill-actions" aria-label="Skill actions">
				<a href={`${import.meta.env.BASE_URL}skills/gic-agent.zip`} download>
					Download skill (ZIP)
				</a>
				<a
					href={`${import.meta.env.BASE_URL}skills/gic-agent.txt`}
					target="_blank"
					rel="noopener noreferrer"
				>
					View raw skill
				</a>
			</section>
		)}
		<article set:html={entry.data.html} />
	</main>
</DocsLayout>

<style>
	.skill-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
</style>
