---
// ABOUTME: Publishes complete example descriptions and manually selectable GIC source.
// ABOUTME: Copies bundled example text without execution or additional failure UI.
import type { ExampleContent } from "@giclang/content/model";
import { createExampleCopyText } from "@giclang/content/model";
import DefaultLayout from "../../layouts/default.astro";
import { examples } from "../../lib/examples.ts";
import checkIcon from "pixelarticons/svg/check.svg?raw";

export function getStaticPaths() {
	return examples.map((example) => ({
		params: { id: example.id },
		props: { example },
	}));
}

interface Props {
	example: ExampleContent;
}

const { example } = Astro.props;
---

<DefaultLayout>
	<main class="example-page">
		<a href={`${import.meta.env.BASE_URL}examples/`}>Back to examples</a>
		<article aria-labelledby="example-title" data-example-id={example.id}>
			<h1 id="example-title">{example.title}</h1>
			<img
				alt={`${example.title} thumbnail`}
				class="example-thumbnail"
				height="100"
				src={example.thumbnailUrl}
				width="100"
			/>
			<div class="content-markdown" set:html={example.html} />
			<pre
				tabindex="0"
				aria-label={`${example.title} source`}
			><code>{example.source}</code></pre>
			<button
				class="application-button"
				aria-label="Copy to clipboard"
				type="button"
				data-copy-text={encodeURIComponent(createExampleCopyText(example))}
			>
				<span class="copy-label">Copy to clipboard</span>
				<span
					class="copy-confirmation"
					aria-hidden="true"
					set:html={checkIcon}
				/>
			</button>
			<p class="copy-status" role="status"></p>
		</article>
	</main>
</DefaultLayout>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>(
		"[data-copy-text]",
	)) {
		const status =
			button.parentElement?.querySelector<HTMLElement>(".copy-status");
		const confirmation =
			button.querySelector<HTMLElement>(".copy-confirmation");
		const payload = button.dataset.copyText;
		if (!status || !confirmation || payload === undefined) continue;
		let feedbackTimeout: number | undefined;
		let confirmationAnimation: Animation | undefined;
		button.addEventListener("click", async () => {
			window.clearTimeout(feedbackTimeout);
			confirmationAnimation?.cancel();
			button.classList.remove("copied");
			status.textContent = "";
			button.disabled = true;
			try {
				await navigator.clipboard.writeText(decodeURIComponent(payload));
				status.setAttribute("role", "status");
				status.textContent = "Copied to clipboard.";
				button.classList.add("copied");
				if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
					confirmationAnimation = confirmation.animate(
						[
							{ opacity: 0, transform: "scale(0.5)", offset: 0 },
							{ opacity: 1, transform: "scale(1)", offset: 0.15 },
							{ opacity: 1, transform: "scale(1)", offset: 0.8 },
							{ opacity: 0, transform: "scale(0.5)", offset: 1 },
						],
						{ duration: 2_000, easing: "steps(3, end)" },
					);
				}
				feedbackTimeout = window.setTimeout(() => {
					button.classList.remove("copied");
					status.textContent = "";
				}, 2_000);
			} catch {
				status.setAttribute("role", "alert");
				status.textContent = "Could not copy to clipboard.";
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<style>
	.example-page {
		padding-bottom: var(--s4);
	}
	.example-page > article > * {
		margin-bottom: var(--s4);
	}

	.example-thumbnail {
		border: 2px solid var(--color-text);
		image-rendering: pixelated;
		margin-block: var(--s3);
		box-shadow: var(--box-shadow);
	}

	pre {
		background-color: var(--color-background);
		max-width: 100%;
		overflow-x: auto;
		user-select: text;
	}

	.application-button {
		background-color: var(--color-background);
		border: 2px solid var(--color-text);
		color: var(--color-text);
		font: inherit;
		padding: var(--s1) var(--s2);
		cursor: pointer;
		position: relative;
		box-shadow: var(--box-shadow);
	}

	.application-button:hover:not(:disabled) {
		background-color: var(--color-control);
	}

	.application-button:disabled {
		cursor: wait;
	}

	.application-button:focus-visible,
	pre:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	.copy-status {
		margin: var(--s0);
	}

	.copy-confirmation {
		align-items: center;
		display: flex;
		inset: 0;
		justify-content: center;
		position: absolute;
		visibility: hidden;
	}

	.copy-confirmation :global(svg) {
		height: 1.25em;
		width: 1.25em;
	}

	.copied .copy-label {
		visibility: hidden;
	}

	.copied .copy-confirmation {
		visibility: visible;
	}

	.copy-status[role="status"] {
		clip-path: inset(50%);
		height: 1px;
		overflow: hidden;
		position: absolute;
		white-space: nowrap;
		width: 1px;
	}
</style>
