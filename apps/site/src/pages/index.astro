---
import { listContentFiles } from "@giclang/content/node";
import { compileMarkdown } from "@giclang/content/markdown";
import DefaultLayout from "../layouts/default.astro";
import "../styles/demo.css";

const source = `// edit me!
repeat(_, 0, 500) {
	fill("lightpink");
	strokeWidth(random(0.2,3));
	circle((1 / sqrt(random(0, 1))) * 50 - WIDTH / 2,
	random(0, HEIGHT),
	random(0, 4));
}
// print("👋🏾 🌎!");
`;

const about = (await listContentFiles("about")).find(
	(file) => file.path === "about/index.md",
);

let page;

if (about?.kind === "markdown") {
	page = compileMarkdown(about.path, about.source);
}
if (!page) {
	throw new Error("No page found");
}
---

<DefaultLayout>
	<main>
		<gic-sketch>
			<section id="demo">
				<div class="preview">
					<canvas width="100" height="100"></canvas>
				</div>
				<div class="editor">
					<label
						for="source"
						style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;"
					>
						Source
					</label>
					<textarea
						id="source"
						spellcheck="false"
						aria-label="Source"
						rows="12"
					>{source}</textarea>
				</div>
			</section>

			<section>
				<h2 id="diagnostics-heading" class="hidden">
					Diagnostics
				</h2>
				<pre id="diagnostics"></pre>
			</section>
			<section>
				<h2 id="output-heading" class="hidden">
					Output
				</h2>
				<pre id="output"></pre>
			</section>
		</gic-sketch>
		<section set:html={page.html} />
	</main>
</DefaultLayout>

<script>
	import { mountPreview } from "@giclang/runtime";

	class GicSketch extends HTMLElement {
		private dispose: (() => void) | undefined;

		connectedCallback() {
			const input = this.querySelector("textarea")!;
			this.dispose = mountPreview({
				canvas: this.querySelector("canvas")!,
				input,
				diagnostics: this.querySelector<HTMLElement>("#diagnostics")!,
				output: this.querySelector<HTMLElement>("#output")!,
				initialCode: input.value,
			});
		}

		disconnectedCallback() {
			this.dispose?.();
			this.dispose = undefined;
		}
	}

	if (!customElements.get("gic-sketch")) {
		customElements.define("gic-sketch", GicSketch);
	}
</script>

<style>
	gic-sketch {
		display: block;
	}
</style>
<script src="../scripts/toggle-runtime-results.ts"></script>
