---
import { listContentFiles } from "@giclang/content/node";
import { compileMarkdown } from "@giclang/content/markdown";
import DefaultLayout from "../layouts/default.astro";
import "../styles/demo.css";

const about = (await listContentFiles("about")).find(
	(file) => file.path === "about/index.md",
);

let page;

if (about?.kind === "markdown") {
	page = compileMarkdown(about.path, about.source);
}
if (!page) {
	throw new Error("No page found");
}
---

<DefaultLayout>
	<section id="demo">
		<div class="preview">
			<canvas width="100" height="100"></canvas>
		</div>
		<div class="editor">
			<label
				for="source"
				style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;"
			>
				Source
			</label>
			<textarea
				id="source"
				spellcheck="false"
				section
				aria-label="Source"
				rows="12"
			></textarea>
		</div>
	</section>

	<section>
		<h2 id="diagnostics-heading" class="hidden">
			Diagnostics
		</h2>
		<pre id="diagnostics"></pre>
	</section>
	<section>
		<h2 id="output-heading" class="hidden">
			Output
		</h2>
		<pre id="output"></pre>
	</section>
	<section set:html={page.html} />
</DefaultLayout>

<script src="../scripts/runtime.js"></script>
<script src="../scripts/toggle-runtime-results.ts"></script>
