---
// ABOUTME: Publishes package-owned examples as static cards with selectable source.
// ABOUTME: Copies authored descriptions and code using the shared content contract.
import { readFile } from "node:fs/promises";
import { compileMarkdown } from "@giclang/content/markdown";
import {
	createExampleCopyText,
	createExamples,
	type ExampleDescription,
} from "@giclang/content/model";
import { listContentFiles } from "@giclang/content/node";
import DefaultLayout from "../layouts/default.astro";

const exampleDescriptions: Record<string, ExampleDescription> = {};
const exampleSources: Record<string, string> = {};
const exampleThumbnails = import.meta.glob<string>(
	"../../../../packages/content/content/examples/*/thumbnail.png",
	{ eager: true, query: "?url&no-inline", import: "default" },
);

for (const file of await listContentFiles("examples")) {
	const path = `/content/${file.path}`;
	if (file.kind === "markdown") {
		const description = compileMarkdown(file.path, file.source);
		if (!("enabled" in description)) {
			throw new Error(`Example description '${file.path}' requires metadata.`);
		}
		exampleDescriptions[path] = description;
	} else if (file.path.endsWith(".gic")) {
		exampleSources[path] = await readFile(file.fileUrl, "utf8");
	}
}

const examples = createExamples({
	exampleDescriptions,
	exampleSources,
	exampleThumbnails,
});
---

<DefaultLayout>
	<main class="examples-page">
		<h1>Examples</h1>
		<ul class="content-card-list">
			{examples.map((example) => (
				<li class="content-card" data-example-id={example.id}>
					<div class="content-card-content">
						<img
							alt={`${example.title} thumbnail`}
							class="example-thumbnail"
							height="100"
							src={example.thumbnailUrl}
							width="100"
							loading="lazy"
						/>
						<h2>{example.title}</h2>
						<div class="content-markdown" set:html={example.html} />
						<pre
							tabindex="0"
							aria-label={`${example.title} source`}
						><code>{example.source}</code></pre>
						<button
							class="application-button"
							type="button"
							data-copy-text={encodeURIComponent(
								createExampleCopyText(example),
							)}
						>
							Copy to clipboard
						</button>
						<p class="copy-status" role="status"></p>
					</div>
				</li>
			))}
		</ul>
	</main>
</DefaultLayout>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>(
		"[data-copy-text]",
	)) {
		const status =
			button.parentElement?.querySelector<HTMLElement>(".copy-status");
		const payload = button.dataset.copyText;
		if (!status || payload === undefined) continue;
		button.addEventListener("click", async () => {
			status.textContent = "";
			button.disabled = true;
			try {
				await navigator.clipboard.writeText(decodeURIComponent(payload));
				status.setAttribute("role", "status");
				status.textContent = "Copied to clipboard.";
			} catch {
				status.setAttribute("role", "alert");
				status.textContent = "Could not copy to clipboard.";
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<style>
	.examples-page {
		max-width: 90rem;
		padding-bottom: var(--s4);
	}

	.content-card-list {
		align-items: flex-start;
		display: flex;
		flex-flow: row wrap;
		gap: var(--s3);
		list-style: none;
		margin: var(--s0);
		padding: var(--s0);
	}

	.content-card {
		flex: 1 1 24rem;
		min-width: 0;
		max-width: 100%;
		list-style: none;
		padding: var(--s0);
	}

	.content-card-content {
		align-items: flex-start;
		background-color: var(--color-background);
		border: 2px solid var(--color-text);
		display: flex;
		flex-direction: column;
		gap: var(--s3);
		padding: var(--s3);
		margin: var(--s0);
	}

	.content-card h2 {
		padding: var(--s0);
	}

	.example-thumbnail {
		border: 2px solid var(--color-text);
		flex: none;
		image-rendering: pixelated;
	}

	.content-markdown {
		min-width: 0;
		width: 100%;
	}

	.content-markdown :global(p:last-child) {
		margin-bottom: var(--s0);
	}

	pre {
		background-color: var(--color-background);
		margin: var(--s0);
		max-width: 100%;
		overflow-x: auto;
		width: 100%;
		user-select: text;
	}

	.application-button {
		background-color: var(--color-background);
		border: 2px solid var(--color-text);
		color: var(--color-text);
		font: inherit;
		padding: var(--s1) var(--s2);
		cursor: pointer;
	}

	.application-button:hover:not(:disabled) {
		background-color: var(--color-control);
	}

	.application-button:disabled {
		cursor: wait;
	}

	.application-button:focus-visible,
	pre:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 2px;
	}

	.copy-status {
		margin: var(--s0);
	}

	.copy-status:empty {
		display: none;
	}
</style>
