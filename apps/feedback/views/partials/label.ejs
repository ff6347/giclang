<%# ABOUTME: Renders frozen questionnaire labels with code-formatted GiC terms. %>
<%# ABOUTME: Escapes every text segment while keeping code markup structural. %>
<% for (const part of labelParts(label)) { %><% if (part.code) { %><code><%= part.text %></code><% } else { %><%= part.text %><% } %><% } %>
