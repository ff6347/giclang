<%# ABOUTME: Renders the shared participant password gate. %>
<%# ABOUTME: Escapes the optional login error before returning it to a participant. %>
<%- include("partials/page-start", { title: "GIC Workshop Feedback", withScript: false }) %>
<h1>GIC Workshop Feedback</h1>
<form method="post" action="/login">
<label for="password">Participant password</label>
<input id="password" name="password" type="password" required autofocus>
<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<button type="submit">Continue</button>
</form>
<%- include("partials/page-end") %>
