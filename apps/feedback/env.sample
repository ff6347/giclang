# ABOUTME: Lists feedback runtime settings with empty secrets and closed submissions.
# ABOUTME: Supports explicit Node env-file loading and Docker Compose interpolation.

# From the monorepo root:
# cp apps/feedback/env.sample apps/feedback/.env
# Node: pnpm --filter @giclang/feedback exec node --env-file=.env src/main.ts
# Compose: docker compose --project-directory . --env-file apps/feedback/.env -f apps/feedback/compose.yaml up --build -d
# pnpm dev:feedback uses development defaults; it does not automatically load .env.

# Three distinct values are required. Never commit the populated .env file.
PARTICIPANT_PASSWORD=

# Each secret requires at least 32 characters. Generate each independently:
# openssl rand -hex 32
ADMIN_SECRET=
COOKIE_SECRET=

# Set true only when ready to accept submissions.
FORM_OPEN=false

# Direct Node settings; DB_PATH is relative to the feedback package directory
# for the Node command above. Compose supplies /data/feedback.sqlite and the
# container's 0.0.0.0:3000 listener instead of these three values.
DB_PATH=./data/feedback.sqlite
HOST=127.0.0.1
PORT=3000
