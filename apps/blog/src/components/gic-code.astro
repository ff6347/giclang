---
interface Props {
	initialCode: string;
}

const { initialCode } = Astro.props;
---

<gic-sketch>
	<canvas width="100" height="100"></canvas>
	<textarea
		name="code"
		class="source"
		aria-label="GIC source"
		spellcheck="false"
	>{initialCode}</textarea>
	<pre class="diagnostics" aria-label="Diagnostics" aria-live="polite"></pre>
	<pre class="output" aria-label="Output" aria-live="polite"></pre>
</gic-sketch>

<script>
	import { mountPreview } from "@giclang/runtime";

	class GicSketch extends HTMLElement {
		private dispose: (() => void) | undefined;

		connectedCallback() {
			const input = this.querySelector("textarea")!;
			this.dispose = mountPreview({
				canvas: this.querySelector("canvas")!,
				input,
				diagnostics: this.querySelector<HTMLElement>(".diagnostics")!,
				output: this.querySelector<HTMLElement>(".output")!,
				initialCode: input.value,
			});
		}

		disconnectedCallback() {
			this.dispose?.();
			this.dispose = undefined;
		}
	}

	if (!customElements.get("gic-sketch")) {
		customElements.define("gic-sketch", GicSketch);
	}
</script>

<style>
	gic-sketch {
		display: flex;
		flex-direction: column;
		gap: var(--s2);
	}
	canvas {
		width: 100px;
		height: 100px;
	}
	textarea.source {
		box-sizing: border-box;
		width: 100%;
		max-height: fit-content;
		tab-size: 2;
		border-radius: 0;
		scrollbar-width: none;
		border: 0;
		padding: var(--s1);
		font-weight: 600;
		font-size: 0.9rem;
		field-sizing: content;
		min-height: 2lh;

		&::-webkit-scrollbar {
			display: none;
		}
	}

	textarea.source:focus-visible {
		outline: 3px dashed var(--color-text);
		outline-offset: 0px;
	}
</style>
