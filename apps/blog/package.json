{
	"name": "@giclang/blog",
	"type": "module",
	"version": "0.1.0",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"prettier": {
		"tabWidth": 2,
		"semi": true,
		"singleQuote": false,
		"useTabs": true,
		"printWidth": 80,
		"proseWrap": "preserve",
		"overrides": [
			{
				"files": [
					"*.yml",
					"*.yaml"
				],
				"options": {
					"useTabs": false
				}
			}
		]
	},
	"dependencies": {
		"@astrojs/mdx": "8.1.1",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"@giclang/content": "workspace:^",
		"@giclang/runtime": "workspace:^",
		"@giclang/styles": "workspace:^",
		"astro": "7.4.2",
		"pixelarticons": "2.4.2",
		"sharp": "0.35.0"
	}
}
